# syntax=docker/dockerfile:1
FROM ghcr.io/astral-sh/uv:0.12.12 AS uv

# Run the full supported Python matrix in an isolated tooling environment.
FROM advian/tox-base:alpine-3.24 AS tox
ARG PYTHON_VERSIONS="3.14 3.13 3.12"
ENV PYENV_ROOT=/root/.pyenv
ENV PATH="/opt/tox/bin:/root/.pyenv/shims:/root/.pyenv/bin:$PATH"
COPY --from=uv /uv /uvx /usr/local/bin/
ARG UV_FIND_LINKS=
ARG UV_INSECURE_HOST=host.docker.internal
RUN resolved="$(pyenv_resolve $PYTHON_VERSIONS)" \
    && for version in $resolved; do pyenv install -s "$version"; done \
    && pyenv global $resolved \
    && uv venv --python "$(pyenv which python)" /opt/tox \
    && uv pip install --python /opt/tox/bin/python 'tox>=4,<5'
WORKDIR /app
COPY . /app
ENTRYPOINT ["/app/docker/entrypoint-tox.sh"]

FROM python:3.14-alpine3.24 AS builder_base
ENV LC_ALL=C.UTF-8 PYTHONFAULTHANDLER=1 PYTHONUNBUFFERED=1 \
    PYTHONHASHSEED=random UV_PROJECT_ENVIRONMENT=/opt/venv \
    PATH="/opt/venv/bin:$PATH"
COPY --from=uv /uv /uvx /usr/local/bin/
ARG UV_FIND_LINKS=
ARG UV_INSECURE_HOST=host.docker.internal
RUN apk add --no-cache bash git tini
WORKDIR /app
COPY uv.lock pyproject.toml README.rst /app/
RUN uv sync --locked --no-install-project

FROM builder_base AS production_build
COPY src /app/src
COPY LICENSE /app/LICENSE
RUN uv sync --locked --no-dev --no-editable

FROM python:3.14-alpine3.24 AS production
ENV PATH="/opt/venv/bin:$PATH" PYTHONUNBUFFERED=1
RUN apk add --no-cache bash tini
COPY --from=production_build /opt/venv /opt/venv
COPY docker/entrypoint.sh /docker-entrypoint.sh
WORKDIR /app
ENTRYPOINT ["/sbin/tini", "--", "/docker-entrypoint.sh"]

FROM builder_base AS devel_build
COPY . /app
RUN uv sync --locked

FROM devel_build AS test
ENTRYPOINT ["/sbin/tini", "--", "/app/docker/entrypoint-test.sh"]

FROM devel_build AS devel_shell
RUN apk add --no-cache zsh \
    && echo '. /opt/venv/bin/activate' >> /root/.zshrc
ENTRYPOINT ["/bin/zsh"]
